			"properties": {
				"description": "Load Files to Sales Folder Parquet Format",
				"activities": [
					{
						"name": "Get_FileName",
						"description": "Get all file names in on prem folder",
						"type": "GetMetadata",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
