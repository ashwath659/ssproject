{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet2",
						"type": "DatasetReference"
					},
					"name": "Fact"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "Geo"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText6",
						"type": "DatasetReference"
					},
					"name": "Product"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Parquet3",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "join2"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductKey as string,",
				"          OrderDateKey as string,",
				"          DueDateKey as string,",
				"          ShipDateKey as string,",
				"          CustomerKey as string,",
				"          PromotionKey as string,",
				"          CurrencyKey as string,",
				"          SalesTerritoryKey as string,",
				"          SalesOrderNumber as string,",
				"          SalesOrderLineNumber as string,",
				"          RevisionNumber as string,",
				"          OrderQuantity as integer,",
				"          UnitPrice as decimal(10,0),",
				"          ExtendedAmount as string,",
				"          UnitPriceDiscountPct as string,",
				"          DiscountAmount as string,",
				"          ProductStandardCost as string,",
				"          TotalProductCost as string,",
				"          SalesAmount as string,",
				"          TaxAmt as string,",
				"          Freight as string,",
				"          CarrierTrackingNumber as string,",
				"          CustomerPONumber as string,",
				"          OrderDate as string,",
				"          DueDate as string,",
				"          ShipDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> Fact",
				"source(output(",
				"          GeographyKey as short,",
				"          City as string,",
				"          StateProvinceCode as string,",
				"          StateProvinceName as string,",
				"          CountryRegionCode as string,",
				"          EnglishCountryRegionName as string,",
				"          SpanishCountryRegionName as string,",
				"          FrenchCountryRegionName as string,",
				"          PostalCode as string,",
				"          SalesTerritoryKey as string,",
				"          IpAddressLocator as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Geo",
				"source(output(",
				"          ProductKey as string,",
				"          ProductAlternateKey as string,",
				"          ProductSubcategoryKey as string,",
				"          WeightUnitMeasureCode as string,",
				"          SizeUnitMeasureCode as string,",
				"          EnglishProductName as string,",
				"          SpanishProductName as string,",
				"          FrenchProductName as string,",
				"          StandardCost as string,",
				"          FinishedGoodsFlag as string,",
				"          Color as string,",
				"          SafetyStockLevel as string,",
				"          ReorderPoint as string,",
				"          ListPrice as string,",
				"          Size as string,",
				"          SizeRange as string,",
				"          Weight as string,",
				"          DaysToManufacture as short,",
				"          ProductLine as string,",
				"          DealerPrice as string,",
				"          Class as string,",
				"          Style as string,",
				"          ModelName as string,",
				"          LargePhoto as string,",
				"          EnglishDescription as string,",
				"          FrenchDescription as string,",
				"          ChineseDescription as string,",
				"          ArabicDescription as string,",
				"          HebrewDescription as string,",
				"          ThaiDescription as string,",
				"          GermanDescription as string,",
				"          JapaneseDescription as string,",
				"          TurkishDescription as string,",
				"          StartDate as string,",
				"          EndDate as string,",
				"          Status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false) ~> Product",
				"Fact, Geo join(Fact@SalesTerritoryKey == Geo@SalesTerritoryKey,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ProductKey,",
				"          OrderDateKey,",
				"          CustomerKey,",
				"          PromotionKey,",
				"          CurrencyKey,",
				"          SalesOrderNumber,",
				"          SalesOrderLineNumber,",
				"          RevisionNumber,",
				"          OrderQuantity,",
				"          UnitPrice,",
				"          ExtendedAmount,",
				"          UnitPriceDiscountPct,",
				"          DiscountAmount,",
				"          ProductStandardCost,",
				"          TotalProductCost,",
				"          SalesAmount,",
				"          TaxAmt,",
				"          Freight,",
				"          CarrierTrackingNumber,",
				"          CustomerPONumber,",
				"          OrderDate,",
				"          GeographyKey,",
				"          City,",
				"          StateProvinceCode,",
				"          StateProvinceName,",
				"          CountryRegionCode,",
				"          SalesTerritoryKey = Geo@SalesTerritoryKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, Product join(select1@ProductKey == Product@ProductKey,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          ProductKey = select1@ProductKey,",
				"          OrderDateKey,",
				"          CustomerKey,",
				"          PromotionKey,",
				"          CurrencyKey,",
				"          SalesOrderNumber,",
				"          SalesOrderLineNumber,",
				"          RevisionNumber,",
				"          OrderQuantity,",
				"          UnitPrice,",
				"          ExtendedAmount,",
				"          UnitPriceDiscountPct,",
				"          DiscountAmount,",
				"          ProductStandardCost,",
				"          TotalProductCost,",
				"          SalesAmount,",
				"          TaxAmt,",
				"          Freight,",
				"          CarrierTrackingNumber,",
				"          CustomerPONumber,",
				"          OrderDate,",
				"          GeographyKey,",
				"          City,",
				"          StateProvinceCode,",
				"          StateProvinceName,",
				"          CountryRegionCode,",
				"          SalesTerritoryKey,",
				"          ProductKey = Product@ProductKey,",
				"          ProductAlternateKey,",
				"          ProductSubcategoryKey,",
				"          WeightUnitMeasureCode,",
				"          SizeUnitMeasureCode,",
				"          StandardCost,",
				"          FinishedGoodsFlag,",
				"          Color,",
				"          SafetyStockLevel,",
				"          ReorderPoint,",
				"          ListPrice,",
				"          Weight,",
				"          DaysToManufacture,",
				"          ProductLine,",
				"          DealerPrice,",
				"          Class,",
				"          Style,",
				"          ModelName,",
				"          EnglishDescription,",
				"          StartDate,",
				"          EndDate,",
				"          Status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 derive(Sales_Amount = UnitPrice * OrderQuantity) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}